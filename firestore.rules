rules_version = '2';
// Amanat security rules. Paste into Firebase console > Firestore > Rules, then Publish.
// Roles and permissions come from the login token (minted by /api/login).
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null && request.auth.token.role in ['admin', 'sorter']; }
    function admin() { return authed() && request.auth.token.role == 'admin'; }
    function can(p) { return admin() || (authed() && request.auth.token.get('perms', {}).get(p, false) == true); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function sendKeys() { return ['done', 'steps', 'tracking', 'receipt', 'packed', 'weight', 'charges']; }

    // Profile cards are shown on the login screen, so anyone may read names and colours.
    match /profiles/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /config/{id} {
      allow read: if authed();
      allow write: if admin();
    }
    match /flights/{id} {
      allow read: if authed();
      allow create: if can('flights');
      allow update: if authed();
      allow delete: if admin();
    }
    match /items/{id} {
      allow read: if authed();
      allow create: if can('upload') && request.resource.data.fid is string;
      allow update: if authed()
        && (can('name') || !changed().hasAny(['name', 'qty', 'note']))
        && (can('upload') || !changed().hasAny(['photos', 'fid']))
        && (can('group') || !changed().hasAny(['groupId']));
      allow delete: if admin();
    }
    match /photos/{id} {
      allow read: if authed();
      allow create: if can('upload');
      allow update, delete: if admin();
    }
    match /receipts/{id} {
      allow read: if authed();
      allow create, update, delete: if can('send');
    }
    match /groups/{id} {
      allow read: if authed();
      allow create: if can('group');
      allow update: if authed()
        && (can('send') || !changed().hasAny(sendKeys()))
        && (can('group') || changed().hasOnly(sendKeys()));
      allow delete: if can('group');
    }
    match /log/{id} {
      allow read, create: if authed();
      allow delete: if admin();
    }
    match /book/{id} {
      allow read, create, update: if authed();
      allow delete: if admin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
